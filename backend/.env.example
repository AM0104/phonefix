APP_NAME="PhoneFix"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Yekaterinburg
# Порт сайта PhoneFix закреплён за этим проектом: 4381 (не пересекается с
# VINPart :8000, CookBook :4173 и портом 4371, который занят другим приложением).
# start-site.ps1 берёт порт отсюда; если он занят, скрипт сам подберёт следующий свободный.
APP_URL=http://127.0.0.1:4381

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

FRONTEND_URL=http://127.0.0.1:5273
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,127.0.0.1:4381,127.0.0.1:5273

LOG_CHANNEL=stack
LOG_LEVEL=debug

# В OSPanel у каждого модуля свой IP: у MySQL это обычно 127.0.1.30
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=phonefix
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
CACHE_STORE=file
FILESYSTEM_DISK=public